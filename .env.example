# ==============================================================================
# Schnell Energy Equipments - Smart Lights Automated Mail & Telemetry Config Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP Email Dispatch Configuration
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=operations@schnellenergy.com
SMTP_PASSWORD=your_email_app_password
SENDER_EMAIL=operations@schnellenergy.com

# Recipients (comma-separated list for both projects)
RECIPIENTS=management@schnellenergy.com,tl@schnellenergy.com

# Optional Project-Specific Recipient Overrides (leave blank to use RECIPIENTS)
TRICHY_RECIPIENTS=
VELLORE_RECIPIENTS=

# ------------------------------------------------------------------------------
# 2. Portal Credentials
# ------------------------------------------------------------------------------
PORTAL_BASE_URL=https://tnsmartlights.in

# Trichy Project (Project ID 7)
TRICHY_PROJECT_ID=7
TRICHY_USERNAME=tycadmin
TRICHY_PASSWORD=tyc12249

# Vellore Project (Project ID 3)
VELLORE_PROJECT_ID=3
VELLORE_USERNAME=vcadmin
VELLORE_PASSWORD=vel5555
